<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:windowBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_gallery"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Upload Leaf Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preview Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_gallery_preview"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_gallery">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_gallery_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/primary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_gallery_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No image selected"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selection Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_select_gallery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Select from Gallery"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toBottomOf="@id/card_gallery_preview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_analyze_gallery"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="Crop &amp; Analyze"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_share"
        app:layout_constraintTop_toBottomOf="@id/btn_select_gallery" />

</androidx.constraintlayout.widget.ConstraintLayout>
