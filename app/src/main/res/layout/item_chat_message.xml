<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Bot Message Bubble -->
    <LinearLayout
        android:id="@+id/ll_bot_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bot_bubble_background"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_bot_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bot message text"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- User Message Bubble -->
    <LinearLayout
        android:id="@+id/ll_user_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:background="@drawable/user_bubble_background"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User message text"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
