# RubberGuard AI Cloud Platform Environment Configuration Template
# Copy this file to .env and replace the placeholders with your actual secrets.
# NEVER commit .env to source control or public repositories.

# Cloud Database Connection String (from Neon Console: https://console.neon.tech)
# If left commented out, the backend automatically falls back to local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HTTP Server Port
PORT=5000

# Cryptographic Token Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_production_jwt_secret_here

# Default Administrator Credentials
ADMIN_EMAIL=admin@rubberguard.org
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: GitHub Release APK Download URL
# APK_DOWNLOAD_URL=https://github.com/Asmitha-M/Rubber-Leaf-Disease-Classification/releases/download/v1.0.0/RubberGuard-AI-release.apk
